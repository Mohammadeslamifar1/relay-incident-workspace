# Local, offline-first defaults. Copy to .env; never commit .env.
RELAY_DATABASE_URL=sqlite:///./data/relay.db
RELAY_AI_PROVIDER=extractive
RELAY_DEMO_ENABLED=true
RELAY_COOKIE_SECURE=false
RELAY_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000","http://127.0.0.1:8000"]
# Use a stable secret for persistent sessions and deployment (at least 32 characters).
# RELAY_SECRET_KEY=replace-with-a-random-secret
# Optional live inference; explicitly selecting openai enables outbound API calls.
# RELAY_AI_PROVIDER=openai
# RELAY_OPENAI_API_KEY=
# RELAY_OPENAI_MODEL=gpt-4.1-mini
